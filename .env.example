# Supabase (Settings → API). Usá la publishable key (sb_publishable_...) o la anon key legacy.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>
# URL pública del sitio (redirects de email/OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "mock" usa datos simulados (uso diario, perfil, machetes) hasta que Backend tenga las RPC.
NEXT_PUBLIC_API_MODE=mock  # mock | supabase (alias: real)

# Server-only (route handlers /api/machetes). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SECRET=
# Solo durante las 24 h de solapamiento tras rotar la clave (N-18b):
# IP_HASH_SECRET_ANTERIOR=

# DO-01 · Donación (estática). Defaults en src/lib/config.ts con los datos reales (alias + titular; sin CVU ni QR todavía).
# Estas variables pisan los defaults; "" oculta ese renglón. ACTIVA=false oculta la tarjeta y los accesos a donar.
NEXT_PUBLIC_DONACION_ACTIVA=true
# NEXT_PUBLIC_DONACION_ALIAS=macheteo.donacion.mp
# NEXT_PUBLIC_DONACION_TITULAR=Anderson Cavalcante Brayner
# NEXT_PUBLIC_DONACION_CVU=
# NEXT_PUBLIC_DONACION_QR_URL=/donacion-qr.png
